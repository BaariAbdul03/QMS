# Normalise line endings in the repository so Windows checkouts do not
# rewrite every file. PHP/SQL/Markdown are stored with LF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.mp3 binary
*.ico binary

# Vendored third-party builds: keep the exact bytes so their SRI hashes stay
# valid. These are Bootstrap 5.3.8 (see README for the published hashes).
public/assets/vendor/* binary
