# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

APP_NAME="Smart QMS"
APP_ENV=local
# 1 = include exception class/file in JSON error responses. Never renders a
# stack trace or credentials; set to 0 in any public environment.
APP_DEBUG=1
# The queue day is computed in this zone, not by the MySQL CURDATE function.
APP_TIMEZONE=Asia/Kolkata
# Only needed when public/ is not the document root, e.g. APP_BASE_PATH=/qms.
APP_BASE_PATH=

# --- Database --------------------------------------------------------------
# Session MySQL 8.0.1+ / MariaDB 10.6+ (SELECT ... FOR UPDATE SKIP LOCKED).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qms
DB_USER=qms
DB_PASSWORD=change-me
# Pinned as the MySQL session time zone so NOW() matches APP_TIMEZONE.
DB_TIMEZONE=+05:30
# Set to 1/true for cloud databases requiring TLS (e.g. TiDB Serverless, Aiven).
DB_SSL=0
DB_SSL_CA=

# --- Queue -----------------------------------------------------------------
QUEUE_NUMBER_PADDING=3
QUEUE_HISTORY_DAYS=3

# --- Security --------------------------------------------------------------
# Generate with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
# Empty value = staff login disabled (fail closed).
STAFF_PASSWORD_HASH=
SESSION_NAME=qms_staff

# Simple per-IP budget for POST /api/tokens. 0 disables the limiter, which is
# what the concurrency test needs (it fires 50 requests from one address).
RATE_LIMIT_TOKENS_PER_MINUTE=10
